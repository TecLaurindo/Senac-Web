      "updated": 1764941422539,
      "link": null,
      "locked": false,
      "text": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        .container {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n        }\n        .div-centralizada {\n            width: 300px;\n            padding: 20px;\n            margin: 10px;\n            background: #eee;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"div-centralizada\">Div 1</div>\n        <div class=\"div-centralizada\">Div 2</div>\n    </div>\n</body>\n</html>",
      "fontSize": 24.062499999999996,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "<!DOCTYPE html>\n<html>\n<head>\n    <style>\n        .container {\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n        }\n        .div-centralizada {\n            width: 300px;\n            padding: 20px;\n            margin: 10px;\n            background: #eee;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"div-centralizada\">Div 1</div>\n        <div class=\"div-centralizada\">Div 2</div>\n    </div>\n</body>\n</html>",
      "autoResize": true,
      "lineHeight": 1.25
    },
